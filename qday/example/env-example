# =============================================================================
# CDK Node - Environment Variables
# =============================================================================
# Copy this file to .env and update values as needed
#   cp env-example .env

# Docker image for CDK node.
# Default: published image (pulled automatically by docker compose).
# To run a locally built image instead, build it with `make build-docker`
# (which tags the image as `cdk`) and set:
#   CDK_NODE_IMAGE=cdk
CDK_NODE_IMAGE=ghcr.io/qday-io/qday-cdk:qday-v0.5.4-fork12

# Log level override (debug, info, warn, error)
CDK_LOG_LEVEL=info

# Docker image for the validator service (batch confirmation signer)
VALIDATOR_IMAGE=ghcr.io/qday-io/qday-aggregator-valdator:main

# Validator signing key (32-byte secp256k1 hex, 0x prefix optional).
# The derived address must match ValidatorAddress in cdk-node-config.toml.
# Default below is the well-known Hardhat test key #2 - replace for production.
VALIDATOR_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
