# =============================================================================
# CDK Node - Environment Variables
# =============================================================================
# Copy this file to .env and update values as needed
#   cp env-example .env

# Docker image for CDK node.
# Default: published image (pulled automatically by docker compose).
# To run a locally built image instead, build it with `make build-docker`
# (which tags the image as `cdk`) and set:
#   CDK_NODE_IMAGE=cdk
CDK_NODE_IMAGE=ghcr.io/0xpolygon/cdk:0.5.4-rc1

# Docker image for the stateless ZK prover (used by the aggregator)
ZKEVM_PROVER_IMAGE=hermeznetwork/zkevm-prover:v8.0.0-RC16-fork.12

# Log level override (debug, info, warn, error)
CDK_LOG_LEVEL=info
